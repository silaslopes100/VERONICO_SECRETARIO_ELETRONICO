# ===========================================================================
# Shortcut — modelo de variáveis de ambiente (COPIE PARA .env E EDITE)
# Nunca comite o arquivo .env real. O arquivo cifrado .env.enc também é
# ignorado pelo git. A chave mestra NUNCA fica em arquivo: ela vem apenas
# da variável de ambiente do sistema operacional SHORTCUT_MASTER_KEY.
# ===========================================================================

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# --- WhatsApp / Playwright ---
WHATSAPP_URL=https://web.whatsapp.com/
WHATSAPP_USER_DATA_DIR=../shortcut_data/whatsapp-profile
HEADLESS=false
POLL_INTERVAL_SECONDS=15

# --- Whisper (transcrição) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- TTS local ---
TTS_RATE=175
TTS_VOICE_INDEX=-1

# --- Captura de áudio do usuário ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_MAX_SECONDS=30

# --- OpenRouter (opcional) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_ENABLED=false

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
